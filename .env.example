APP_NAME=Cartoon AI
ENVIRONMENT=development
API_PREFIX=/api
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5190,http://127.0.0.1:5190
MAX_IMAGE_UPLOAD_MB=25
MAX_AUDIO_UPLOAD_MB=50
ALLOW_CLASSIC_FALLBACK=true
CARTOON_ENGINE=auto
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
JOB_WORKERS=2
JOB_RETENTION_HOURS=168
ASSET_RETENTION_DAYS=30
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60
REQUIRE_AUTH=false
SHARE_SECRET=change-me-share-secret
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GCS_BUCKET=
GCS_CREDENTIALS_JSON=
LOG_LEVEL=INFO
